  - m_Id: 8656292592230400
    m_Localized: 'Gebruikersomgeving:'
    m_Metadata:
      m_Items: []
  - m_Id: 8657711231672320
    m_Localized: Geluidseffect
    m_Metadata:
      m_Items: []
  - m_Id: 8679443594223616
    m_Localized: Zwaai naar je vijanden in gevechten van dichtbij met dit richtbare
      wapen.
    m_Metadata:
      m_Items: []
  - m_Id: 8681660766232576
    m_Localized: Stuur vinylplaten uit als boemerangs.
    m_Metadata:
      m_Items: []
  - m_Id: 8682358585171968
    m_Localized: Zwaai rond permanente jojo's die versnellen met de beat.
    m_Metadata:
      m_Items: []
  - m_Id: 8682671060819968
    m_Localized: Gooi discoballen in de lucht.
    m_Metadata:
      m_Items: []
  - m_Id: 8683098003218432
    m_Localized: Elektriseer je dichtstbijzijnde vijanden.
    m_Metadata:
      m_Items: []
  - m_Id: 8683268652670976
    m_Localized: Schiet muzieknoten op je dichtstbijzijnde vijanden.
    m_Metadata:
      m_Items: []
  - m_Id: 8685023268446208
    m_Localized: 'Beschadig alle vijanden die dichtbij je zijn. '
    m_Metadata:
      m_Items: []
  - m_Id: 8685223521296384
    m_Localized: Stuur Synthwave-schokken in elke richting.
    m_Metadata:
      m_Items: []
  - m_Id: 8686385045708800
    m_Localized: Trek uw rolschaatsen aan en versnel uw bewegingen.
    m_Metadata:
      m_Items: []
  - m_Id: 8686784410558464
    m_Localized: Trek je Disco Pantser aan en demp de slagen van je vijanden.
    m_Metadata:
      m_Items: []
  - m_Id: 8686988761243648
    m_Localized: Laat je vijanden langzamer bewegen met je Rustige Sfeer.
    m_Metadata:
      m_Items: []
  - m_Id: 8687225626173440
    m_Localized: "Laat het geld regenen om je vijanden af \u200B\u200Bte leiden."
    m_Metadata:
      m_Items: []
  - m_Id: 8687432912871424
    m_Localized: Duwt vijanden weg om jezelf meer ruimte te geven.
    m_Metadata:
      m_Items: []
